# ==== qBittorrent Web API ====
# WebUI 地址（本机 8080 已被占用，建议 qB 用 8081）
QB_BASE_URL=http://127.0.0.1:8081
# 推荐：qB 4.6+ 的 API Key（设置 > Web UI > API 密钥），设置后无需账号密码
QB_API_KEY=
# 备选：WebUI 登录账号（仅在未设置 QB_API_KEY 时使用）
QB_USERNAME=admin
QB_PASSWORD=

# ==== MySQL ====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pt_download
DB_CONNECTION_LIMIT=5

# ==== Server ====
PORT=3000
LOG_LEVEL=info

# ==== 定时轮询 ====
# 是否开启后台自动轮询（抓取 RSS → 评估规则 → 自动下发）
POLL_ENABLED=true
# 调度器检查间隔（秒）；各站实际抓取频率由 sites.poll_interval_sec 控制
POLL_TICK_SEC=60
